{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**/*.js",
      "src/**/*.html",
      "src/**/*.css",
      "!src/js/tinykeys.module.js",
      "!src/js/otpauth.esm.js",
      "!src/js/colors.js",
      "scripts/*.mjs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 120,
    "useEditorconfig": true,
    "formatWithErrors": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noUnusedTemplateLiteral": "off",
        "useBlockStatements": "error"
      },
      "suspicious": {
        "noEmptyBlock": "off",
        "useIterableCallbackReturn": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    },
    "experimentalEmbeddedSnippetsEnabled": true
  },
  "assist": {
    "enabled": true
  }
}
