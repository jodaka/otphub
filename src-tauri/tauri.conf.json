{
  "build": {
    "frontendDist": "../src"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "productName": "otphub",
  "mainBinaryName": "otphub",
  "version": "1.0.10",
  "identifier": "com.kudris.otphub",
  "plugins": {},
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "otphub",
        "width": 350,
        "height": 530,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "dragDropEnabled": false,
        "useHttpsScheme": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
